{
  "description": "Gin workflow safety hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/safety-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
