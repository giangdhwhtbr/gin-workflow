#!/bin/sh
# generated by gin-workflow team init; remove this line to keep local edits
# Enforces the team commit convention ({{convention}}). Enable per clone: git config core.hooksPath .githooks
convention="{{convention}}"
[ "$convention" = "none" ] && exit 0
subject=$(sed -n '/^[^#]/{p;q;}' "$1")
case "$subject" in
  "Merge "*|"fixup! "*|"squash! "*|"Revert \""*) exit 0 ;;
esac
if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'; then
  exit 0
fi
echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(api): add login'" >&2
echo "commit-msg: got: $subject" >&2
exit 1
