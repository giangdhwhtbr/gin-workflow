# Ignore generated/compiled plugin assets
plugins/*/dist/
# Harness project installations are generated from plugin source.
/.codex/
/.claude/
/.agents/
# OpenCode project install: ignore only the generated bundle, so a repository can
# still track its own .opencode/opencode.json, agents, and commands.
/.opencode/skills/
/.opencode/references/
/.opencode/scripts/
/.opencode/rules/
/.opencode/templates/
/.opencode/examples/

# OS/Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python generated files
__pycache__/
*.pyc

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/
.agent-workflow/providers.local.yaml

# bv (beads viewer) local config and caches
.bv/

# Bead worktrees: local working copies, not meant to be tracked as gitlinks
# in the main repo (they were being picked up as orphan 160000 entries with
# no .gitmodules, causing constant spurious "modified" status).
.planning/worktrees/
# br doctor per-run artifacts
.doctor/

# CodeGraph index: machine-local database and daemon files
.codegraph/
