{
  "PreToolUse": [
    {
      "matcher": "Bash|run_command",
      "hooks": [
        {
          "type": "command",
          "command": "${PLUGIN_ROOT}/scripts/safety-check.sh",
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "write_to_file|replace_file_content",
      "hooks": [
        {
          "type": "command",
          "command": "${PLUGIN_ROOT}/scripts/post-edit.sh"
        }
      ]
    }
  ]
}
