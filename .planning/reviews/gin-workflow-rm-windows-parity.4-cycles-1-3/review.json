      "payload": {
        "finding_id": "which-cwd-autorun",
        "reason": "In production argv[0] is already the absolute path that workflow_core.executable_resolver.resolve_harness_executable returned (registry.py factory passes resolved_exe), so shutil.which returns that path unchanged and never searches the current directory; a bare name reaches which only when the resolver failed, and /d now skips AutoRun. Ignoring the current directory for bare names would need Python 3.12 NoDefaultCurrentDirectoryInExePath semantics and is out of this track's scope."
      },
      "previous_event_hash": "687f6241d5bc105f81b1fd9be037f654f8fb9fbc899f4b04081ca477838b5974",
